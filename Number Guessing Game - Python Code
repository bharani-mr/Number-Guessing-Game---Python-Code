
import random
import math
import time

while True:

    secret_number = random.randint(1, 100)
    attempts = 0
    max_attempts = 7
    time_limit = 60
    start_time = None
    game_over = False

    print("\n================================")
    print("       NUMBER GUESSING GAME")
    print("================================")

    # Check Prime Number
    if secret_number > 1:
        prime = True
        for i in range(2, secret_number):
            if secret_number % i == 0:
                prime = False
                break
    else:
        prime = False

    # Check Perfect Square
    square = math.isqrt(secret_number) ** 2 == secret_number

    # Check Perfect Number
    total = 0
    for i in range(1, secret_number):
        if secret_number % i == 0:
            total += i

    perfect = total == secret_number

    # Check Even or Odd
    if secret_number % 2 == 0:
        even_odd = "Even"
    else:
        even_odd = "Odd"

    print("\nSecret Number Properties:")
    print("Prime Number:", "Yes" if prime else "No")
    print("Perfect Square:", "Yes" if square else "No")
    print("Perfect Number:", "Yes" if perfect else "No")
    print("Number Type:", even_odd)

    print("\nGuess a number between 1 and 100.")
    print("You have 7 attempts and 1 minute.")

    # Game Loop
    while attempts < max_attempts:

        if start_time is not None:
            remaining_time = time_limit - (time.time() - start_time)

            if remaining_time <= 0:
                print("\nTime Up! Game Over!")
                game_over = True
                break

            print("\nTime Remaining:", int(remaining_time), "seconds")

        try:
            guess = int(input("\nEnter your guess: "))

            if guess < 1 or guess > 100:
                print("Please enter a number between 1 and 100.")
                continue

        except ValueError:
            print("Invalid input! Please enter a number.")
            continue

        # Start timer after first valid guess
        if start_time is None:
            start_time = time.time()

        attempts += 1

        # Check timer again after input
        remaining_time = time_limit - (time.time() - start_time)

        if remaining_time <= 0:
            print("\nTime Up! Game Over!")
            game_over = True
            break

        # Check Guess
        if guess == secret_number:
            print("\nCongratulations! Right Guess!")
            print("You won the game!")
            print("Number of attempts:", attempts)
            game_over = True
            break

        difference = abs(secret_number - guess)

        if guess < secret_number:
            print("Too Low!")
        else:
            print("Too High!")

        # Give Near Hints
        if difference <= 5:
            print("Very Close to the secret number!")
        elif difference <= 10:
            print("You are near to the secret number!")

        print("Attempts Left:", max_attempts - attempts)

    # Game Over Message
    if attempts == max_attempts and not game_over:
        print("\nGame Over! You used all 7 attempts.")

    if game_over and attempts < max_attempts:
        if start_time is not None and time.time() - start_time >= time_limit:
            print("The correct number was:", secret_number)

    if attempts == max_attempts and (guess != secret_number):
        print("The correct number was:", secret_number)

    # Restart Option
    print("\nDo you want to play again?")
    choice = input("Enter Y for Yes or N for No: ").lower()

    if choice != "y":
        print("\nThank you for playing!")
        break
